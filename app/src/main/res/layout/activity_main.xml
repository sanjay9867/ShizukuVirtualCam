<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D5C3A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="6D Offline Mode"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShizukuBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_dark"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:text="● Checking..."
                android:textColor="#2EE87A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live 6D Animated Preview Frame -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#082418"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="#287C56"
            app:strokeWidth="1.5dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivLivePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Live 6D Face Preview" />

                <TextView
                    android:id="@+id/tvPreviewOverlayHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Upload a Face Photo below\n100% Offline 6D Depth-Relief Engine"
                    android:textColor="#A8DFC2"
                    android:textSize="14sp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live 6D Telemetry Strip -->
        <TextView
            android:id="@+id/tv6DReadout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center"
            android:padding="6dp"
            android:text="6D  Y:0°  P:0°  R:0°  |  X:0.00  Y:0.00  Z:0.00"
            android:textColor="#A5F3C4"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Flip + Zoom Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flip"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <Spinner
                android:id="@+id/spinnerFlip"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_dark"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zoom"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <Button
                    android:id="@+id/btnZoomMinus"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="38dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="−"
                    android:textColor="#2EE87A"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvZoomValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0x"
                    android:textColor="#D9F9E6"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnZoomPlus"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="38dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="#2EE87A"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 6D D-Pad + Mode Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <Button
                    android:id="@+id/btnPadMode"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="#082418"
                    android:text="Pad: Rotate 3D"
                    android:textColor="#2EE87A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp" />

                <Button
                    android:id="@+id/btnAutoMove"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="#082418"
                    android:text="6D Auto: OFF"
                    android:textColor="#2EE87A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp" />

                <Button
                    android:id="@+id/btnGyro6D"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="#082418"
                    android:text="Gyro 6D: OFF"
                    android:textColor="#2EE87A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp">

                    <Button
                        android:id="@+id/btnBlink"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="#082418"
                        android:padding="0dp"
                        android:text="Blink"
                        android:textColor="#2EE87A"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnSmile"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#082418"
                        android:padding="0dp"
                        android:text="Smile"
                        android:textColor="#2EE87A"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnIdleToggle"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:backgroundTint="#082418"
                    android:text="Idle: ON"
                    android:textColor="#D9F9E6"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.sanjay.shizukuvcam.ui.FaceDpadView
                android:id="@+id/faceDpad"
                android:layout_width="184dp"
                android:layout_height="184dp" />
        </LinearLayout>

        <!-- Roll + Depth Z Sliders (Completes All 6 Axes) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:text="Head Roll"
                    android:textColor="#D9F9E6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekRoll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:text="3D Depth Z"
                    android:textColor="#D9F9E6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekDepthZ"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100" />
            </LinearLayout>

            <Button
                android:id="@+id/btnReset6D"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#082418"
                android:text="Reset All 6 Axes to Center"
                android:textColor="#2EE87A"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Launch Floating Menu Over Brave -->
        <Button
            android:id="@+id/btnFloatOverlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#1DB954"
            android:text="Launch 6D Floating Menu (Over Brave)"
            android:textColor="#041F13"
            android:textStyle="bold" />

        <!-- Source Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_panel"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Offline Face Photo / Video Source"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFeedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:text="Status: 100% Offline Ready — Upload a face photo or MP4"
                android:textColor="#B9EBD0"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnUploadPhoto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#1DB954"
                    android:text="Upload Face Photo"
                    android:textColor="#041F13"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnUploadVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#082418"
                    android:text="Upload MP4 Video"
                    android:textColor="#2EE87A" />
            </LinearLayout>

            <com.sanjay.shizukuvcam.RealVirtualToggleButton
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:contentDescription="Toggle between real camera and virtual camera feed" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchEnableVCam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Enable Virtual Camera Feed"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Target App Sync & Shizuku Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Target App &amp; Shizuku Sync"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerApps"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_dark"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btnSyncTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#1DB954"
                android:text="Sync to Target App &amp; Force-Stop"
                android:textColor="#041F13"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnReconnectShizuku"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#082418"
                    android:text="Reconnect Shizuku"
                    android:textColor="#2EE87A" />

                <Button
                    android:id="@+id/btnOpenLSPatch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#082418"
                    android:text="Open LSPatch"
                    android:textColor="#2EE87A" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
