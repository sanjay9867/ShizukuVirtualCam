<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="224dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_panel"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Drag Bar -->
    <LinearLayout
        android:id="@+id/overlayHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="6D Offline Menu"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnOverlayCollapse"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="−"
            android:textColor="#2EE87A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnOverlayClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="×"
            android:textColor="#FF8A8A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlayBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.sanjay.shizukuvcam.ui.FaceDpadView
            android:id="@+id/overlayDpad"
            android:layout_width="154dp"
            android:layout_height="154dp"
            android:layout_marginBottom="6dp" />

        <!-- Roll Left/Right & Depth Z-/Z+ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">

            <Button
                android:id="@+id/btnOverlayRollLeft"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#082418"
                android:padding="0dp"
                android:text="↶ R"
                android:textColor="#2EE87A"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnOverlayRollRight"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#082418"
                android:padding="0dp"
                android:text="R ↷"
                android:textColor="#2EE87A"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnOverlayDepthOut"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#082418"
                android:padding="0dp"
                android:text="Z −"
                android:textColor="#2EE87A"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnOverlayDepthIn"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:backgroundTint="#082418"
                android:padding="0dp"
                android:text="Z +"
                android:textColor="#2EE87A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Axis Switch + Flip + Blink -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">

            <Button
                android:id="@+id/btnOverlayAxisMode"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1.6"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#082418"
                android:padding="0dp"
                android:text="Pad: Rot 3D"
                android:textColor="#2EE87A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOverlayFlip"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="0.9"
                android:layout_marginEnd="3dp"
                android:backgroundTint="#082418"
                android:padding="0dp"
                android:text="Flip"
                android:textColor="#2EE87A"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnOverlayBlink"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:backgroundTint="#1DB954"
                android:padding="0dp"
                android:text="Blink"
                android:textColor="#041F13"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 6D Auto + Gyro 6D -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOverlayAutoMove"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#082418"
                android:padding="0dp"
                android:text="6D Auto"
                android:textColor="#2EE87A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOverlayGyro"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:backgroundTint="#082418"
                android:padding="0dp"
                android:text="Gyro 6D"
                android:textColor="#2EE87A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
