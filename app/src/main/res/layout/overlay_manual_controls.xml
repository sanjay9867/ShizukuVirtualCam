<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="210dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_panel"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Drag Bar -->
    <LinearLayout
        android:id="@+id/overlayHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Manual Mode"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnOverlayCollapse"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="−"
            android:textColor="#2EE87A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnOverlayClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="×"
            android:textColor="#FF8A8A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlayBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.sanjay.shizukuvcam.ui.FaceDpadView
            android:id="@+id/overlayDpad"
            android:layout_width="156dp"
            android:layout_height="156dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnOverlayZoomOut"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#082418"
                android:padding="0dp"
                android:text="Z −"
                android:textColor="#2EE87A"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOverlayZoomIn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#082418"
                android:padding="0dp"
                android:text="Z +"
                android:textColor="#2EE87A"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOverlayFlip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:backgroundTint="#082418"
                android:padding="0dp"
                android:text="Flip"
                android:textColor="#2EE87A"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOverlayBlink"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1DB954"
                android:padding="0dp"
                android:text="Blink"
                android:textColor="#041F13"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOverlaySmile"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:backgroundTint="#082418"
                android:padding="0dp"
                android:text="Smile"
                android:textColor="#2EE87A"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
